# Scope the native Neo cloud archive. This file replaces .gitignore for EAS uploads.
# Patterns are rooted so they do not match Swift paths such as Core/Services.

# Unrelated Expo application
/app
/app/**
/app.json
/assets
/assets/**
/components
/components/**
/constants
/constants/**
/context
/context/**
/hooks
/hooks/**
/index.js
/lib
/lib/**
/scripts
/scripts/**
/services
/services/**
/supabase
/supabase/**
/types
/types/**
/utils
/utils/**
/package.json
/package-lock.json
/tsconfig.json
/expo-env.d.ts
/LICENSE
/README.md
/AGENTS.md
/CLAUDE.md
/.expo
/.expo/**
/.claude
/.claude/**
/.vscode
/.vscode/**
/dist
/dist/**
/web-build
/web-build/**
/ios
/ios/**
/android
/android/**

# Secrets, caches, and local artifacts
.git
.git/**
**/.env
**/.env.*
**/*.pem
**/*.p8
**/*.p12
**/*.key
**/*.jks
**/*.mobileprovision
**/.DS_Store
**/.temp
**/.temp/**
**/.branches
**/.branches/**
**/DerivedData
**/DerivedData/**
**/xcuserdata
**/xcuserdata/**
**/*.xcuserstate
**/Secrets.xcconfig
/Apple/Neo/ios/Pods
/Apple/Neo/ios/Pods/**
/Apple/Neo/ios/build
/Apple/Neo/ios/build/**
/Apple/Neo/ios/Gymfile

# Uncommitted files the iOS compile does not need
/Apple/Neo/Supabase/delete-account.sql
/Apple/Neo/Supabase/schema.sql
/Apple/Neo/docs/database-architecture.md
